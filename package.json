{
  "name": "@arki/geo",
  "version": "0.2.0",
  "description": "Geospatial toolkit for ARKI: coordinates and distance maths, cached geocoding with typed failures, and React map components.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/arki-labs/arki.git"
  },
  "homepage": "https://arki.dev",
  "bugs": {
    "url": "https://github.com/arki-labs/arki/issues"
  },
  "keywords": [
    "arki",
    "typescript",
    "geo",
    "geocoding",
    "maps",
    "coordinates",
    "distance"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./geocoding": {
      "types": "./dist/geocoding/index.d.ts",
      "import": "./dist/geocoding/index.js",
      "default": "./dist/geocoding/index.js"
    },
    "./react/google-maps": {
      "types": "./dist/maps/google/index.d.ts",
      "import": "./dist/maps/google/index.js",
      "default": "./dist/maps/google/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**",
    "!dist/**/*.test.*",
    "!dist/**/__tests__/**",
    "src/**",
    "!src/**/*.test.*",
    "!src/**/*.spec.*",
    "!src/**/__tests__/**",
    "README.md",
    "docs/**",
    "llms.txt",
    "LICENSE",
    "CHANGELOG.md",
    "package.json"
  ],
  "dependencies": {
    "@arki/contracts": "0.4.1",
    "@arki/env": "0.2.0",
    "@arki/failure": "0.3.0",
    "@arki/kv": "0.5.0",
    "@arki/log": "0.4.0",
    "@arki/schema": "0.3.0",
    "@t3-oss/env-core": "^0.13.11",
    "node-fetch": "^2.7.0",
    "node-geocoder": "^4.4.1",
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "@vis.gl/react-google-maps": "^1.10.1",
    "leaflet": "^1.9.4",
    "mapbox-gl": "^3.32.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-leaflet": "^5.0.0",
    "react-map-gl": "^8.1.3"
  },
  "peerDependenciesMeta": {
    "@vis.gl/react-google-maps": {
      "optional": true
    },
    "leaflet": {
      "optional": true
    },
    "mapbox-gl": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "react-leaflet": {
      "optional": true
    },
    "react-map-gl": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
